{
  "$schema": "https://www.raycast.com/schemas/extension.json",
  "name": "linkding",
  "title": "Linkding Bookmarks",
  "description": "Save pages to a self-hosted linkding server.",
  "icon": "extension-icon.png",
  "author": "limxingzhi",
  "categories": [
    "Productivity"
  ],
  "license": "MIT",
  "platforms": [
    "macOS",
    "Windows"
  ],
  "commands": [
    {
      "name": "add-bookmark",
      "title": "Add Bookmark",
      "description": "Save a page to linkding.",
      "mode": "view",
      "arguments": [
        {
          "name": "link",
          "type": "text",
          "placeholder": "https://example.com",
          "required": false
        }
      ]
    }
  ],
  "preferences": [
    {
      "name": "serverUrl",
      "title": "Server URL",
      "description": "Base URL of your linkding instance. /api is added automatically.",
      "type": "textfield",
      "required": true,
      "placeholder": "https://linkding.example.com"
    },
    {
      "name": "apiToken",
      "title": "API Token",
      "description": "Token from linkding Settings.",
      "type": "password",
      "required": true,
      "placeholder": "API token"
    },
    {
      "name": "tags",
      "title": "Tags",
      "description": "Comma-separated tags offered in the form.",
      "type": "textfield",
      "required": false,
      "placeholder": "dev, reading, work"
    }
  ],
  "scripts": {
    "build": "ray build -e dist",
    "dev": "ray develop",
    "fix-lint": "ray lint --fix",
    "lint": "ray lint",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@raycast/api": "^2.13.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@raycast/eslint-config": "^2.2.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-test-renderer": "^19.3.1",
    "eslint": "^10.15.0",
    "prettier": "^3.10.1",
    "react": "^19.3.1",
    "react-test-renderer": "^19.3.1",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
  }
}
